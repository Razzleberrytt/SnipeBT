{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "zod": ["vendor/zod"],
      "prom-client": ["vendor/prom-client"],
      "telegraf": ["vendor/telegraf"],
      "better-sqlite3": ["vendor/better-sqlite3"],
      "node-fetch": ["vendor/node-fetch"],
      "*": ["./node_modules/*"]
    },
    "typeRoots": [
      "./vendor",
      "./node_modules/@types"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
