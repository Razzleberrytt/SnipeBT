# Primary Solana RPC endpoint (URL)
RPC_PRIMARY=https://example-rpc-primary

# Backup Solana RPC endpoint (URL)
RPC_BACKUP=https://example-rpc-backup

# Jupiter quote/base API URL
JUPITER_BASE_URL=https://quote-api.jup.ag

# Trading risk limits
SLIPPAGE_BPS=50
MAX_RISK_PCT=25
MAX_POS_PCT=10
MAX_CU_PRICE=10000

# Optional Telegram bot integration
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Secret provider configuration
# SECRET_PROVIDER=local
# SECRET_SERVICE=
# SECRET_ACCOUNT=

# Metrics server configuration
METRICS_PORT=9464

# Data directory for stateful artifacts
DATA_DIR=./data

# Run mode defaults to dry-run (true|false)
DRY_RUN=true
