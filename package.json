{
  "name": "snipebt",
  "version": "2.0.0",
  "description": "Solana trading and sniping bot",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start:dry": "node -r dotenv/config dist/main.js",
    "start:live": "cross-env DRY_RUN=false node -r dotenv/config dist/main.js --live",
    "dev": "ts-node src/main.ts",
    "migrate": "echo no-migrations",
    "lint": "echo no-lint && exit 0",
    "test": "echo no-tests && exit 0"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "dotenv": "^16.4.5",
    "prom-client": "^15.1.3",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "cross-env": "^7.0.3"
  }
}
