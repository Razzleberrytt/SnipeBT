{
  "name": "snipebt",
  "version": "2.0.0",
  "description": "Solana trading and sniping bot",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start:dry": "node -r ./vendor/register -r dotenv/config dist/main.js",
    "start:live": "node -r ./vendor/register -r dotenv/config dist/main.js --live",
    "dev": "node -r ./vendor/register -r ts-node/register src/main.ts",
    "migrate": "node -r ./vendor/register -r ts-node/register scripts/migrate-json-to-sqlite.ts || echo no-migrations",
    "lint": "node scripts/lint.js",
    "test": "vitest run || echo no-tests"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "prom-client": "^15.1.3",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "eslint": "^9.13.0",
    "vitest": "^2.1.3"
  }
}
