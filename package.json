{
  "name": "snipebt",
  "version": "2.0.0",
  "description": "Solana trading and sniping bot",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run start:dry",
    "start:dev": "nodemon --watch src --exec \"ts-node --project tsconfig.json\" src/main.ts --mode dry",
    "start:dry": "node dist/main.js --mode dry",
    "start:live": "node dist/main.js --mode live --live",
    "test": "jest",
    "lint": "eslint --ext .ts,.js src scripts",
    "migrate": "ts-node --project tsconfig.json scripts/migrate-json-to-sqlite.ts",
    "health": "ts-node --project tsconfig.json scripts/health-check.ts"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "0.2.30-alpha",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.95.5",
    "axios": "1.12.2",
    "better-sqlite3": "9.6.0",
    "bs58": "6.0.0",
    "dotenv": "16.5.0",
    "keytar": "7.9.0",
    "node-telegram-bot-api": "0.66.0",
    "pino": "9.4.0",
    "prom-client": "15.1.3",
    "telegraf": "4.16.3",
    "technicalindicators": "3.1.0",
    "ts-node": "10.9.2",
    "twitter-api-v2": "1.16.3",
    "typescript": "5.6.5",
    "vader-sentiment": "1.1.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "22.7.7",
    "@types/node-telegram-bot-api": "0.64.12",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "@types/better-sqlite3": "7.6.10",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-unused-imports": "4.0.4",
    "jest": "29.7.0",
    "nodemon": "3.1.9",
    "prettier": "3.3.3",
    "pino-pretty": "11.2.2",
    "ts-jest": "29.2.4"
  }
}
